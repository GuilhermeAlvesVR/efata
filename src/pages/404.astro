---
import Base from '../layouts/Base.astro';
---
<Base titulo="Página não encontrada">
  <section class="secao">
    <div class="container erro">
      <span class="sobretitulo">Erro 404</span>
      <h1>Página não encontrada</h1>
      <p>O endereço pode ter mudado ou não existe mais.</p>
      <a class="botao" href="/">Voltar ao início</a>
    </div>
  </section>
</Base>

<style>
  .erro {
    text-align: center;
    padding-block: 48px;
  }
</style>

---
import Base from '../layouts/Base.astro';
import { configuracoes } from '../lib/conteudo';

const config = await configuracoes();
// O pedido vai pelo WhatsApp da igreja; sem WhatsApp, vai por e-mail; sem nenhum dos dois, o formulário fica desativado.
const destino = config.whatsapp ? 'whatsapp' : config.email ? 'email' : null;
---
<Base titulo="Pedido de oração" descricao="Envie seu pedido de oração. Vamos orar por você.">
  <header class="cabecalho-pagina">
    <div class="container">
      <span class="sobretitulo">Estamos com você</span>
      <h1>Pedido de oração</h1>
      <p>
        “Não estejais inquietos por coisa alguma; antes, as vossas petições sejam em tudo conhecidas diante de Deus pela oração e
        súplica, com ação de graças.” — Filipenses 4:6
      </p>
    </div>
  </header>

  <section class="secao">
    <div class="container oracao">
      {
        destino ? (
          <form class="cartao formulario" data-destino={destino} data-whatsapp={config.whatsapp} data-email={config.email}>
            <label>
              <span>Seu nome <em>(opcional)</em></span>
              <input name="nome" type="text" autocomplete="given-name" maxlength="80" placeholder="Deixe em branco para enviar sem nome" />
            </label>
            <label>
              <span>Seu pedido</span>
              <textarea name="pedido" rows="6" required maxlength="1500" placeholder="Escreva aqui pelo que você quer que a gente ore" />
            </label>
            <label class="opcao">
              <input name="contato" type="checkbox" />
              <span>Gostaria que alguém da igreja conversasse comigo</span>
            </label>
            <button class="botao" type="submit">
              {destino === 'whatsapp' ? 'Enviar pelo WhatsApp' : 'Enviar por e-mail'}
            </button>
            <p class="aviso">
              {destino === 'whatsapp'
                ? 'O pedido abre no seu WhatsApp, pronto para enviar. Mesmo sem nome, a igreja verá o número de quem enviou.'
                : 'O pedido abre no seu aplicativo de e-mail, pronto para enviar.'}
            </p>
          </form>
        ) : (
          <div class="cartao formulario">
            <p class="vazio">Em breve você poderá enviar seu pedido de oração por aqui.</p>
          </div>
        )
      }
      <aside class="apoio">
        <h2>Você não está sozinho</h2>
        <p>
          Todo pedido é recebido com carinho e levado em oração pela nossa equipe de intercessão. Se preferir, venha a um dos nossos
          cultos: será uma alegria orar com você pessoalmente.
        </p>
        <a class="link-seta" href="/cultos">Horários e endereço</a>
      </aside>
    </div>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('form[data-destino]');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const dados = new FormData(form);
    const nome = String(dados.get('nome') ?? '').trim();
    const pedido = String(dados.get('pedido') ?? '').trim();
    if (!pedido) return;

    const linhas = ['🙏 Pedido de oração', '', `Nome: ${nome || 'Anônimo'}`, '', pedido];
    if (dados.get('contato')) linhas.push('', 'Gostaria que alguém da igreja conversasse comigo.');
    const texto = linhas.join('\n');

    const { destino, whatsapp, email } = form.dataset;
    const url =
      destino === 'whatsapp'
        ? // Link direto: o redirecionamento do wa.me corrompe emojis como o 🙏.
          `https://api.whatsapp.com/send?phone=${whatsapp}&text=${encodeURIComponent(texto)}`
        : `mailto:${email}?subject=${encodeURIComponent('Pedido de oração')}&body=${encodeURIComponent(texto)}`;
    location.href = url;
  });
</script>

<style>
  .oracao {
    display: grid;
    gap: 32px;
    align-items: start;
  }
  @media (min-width: 860px) {
    .oracao {
      grid-template-columns: 1.3fr 0.7fr;
      gap: 48px;
    }
  }
  .formulario {
    display: grid;
    gap: 20px;
    padding: 28px;
  }
  label {
    display: grid;
    gap: 6px;
    font-weight: 600;
  }
  label em {
    font-weight: 400;
    color: var(--cinza);
  }
  input[type='text'],
  textarea {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid var(--linha);
    border-radius: 10px;
    background: var(--papel);
    color: var(--tinta);
    font: inherit;
    font-weight: 400;
  }
  input[type='text']:focus,
  textarea:focus {
    outline: 2px solid var(--vermelho);
    outline-offset: 0;
    border-color: transparent;
    background: var(--branco);
  }
  textarea {
    resize: vertical;
  }
  .opcao {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 400;
  }
  .opcao input {
    width: 20px;
    height: 20px;
    accent-color: var(--vermelho);
  }
  .formulario .botao {
    justify-self: start;
  }
  .aviso {
    margin: 0;
    font-size: 0.9rem;
    color: var(--tinta-suave);
  }
  .apoio p {
    color: var(--tinta-suave);
  }
</style>

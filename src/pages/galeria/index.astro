---
import Base from '../../layouts/Base.astro';
import { albuns, versaoDaFoto } from '../../lib/galeria';
import { formatarData } from '../../lib/conteudo';

const lista = await albuns();
---
<Base titulo="Galeria de fotos" descricao="Fotos dos cultos e eventos da igreja.">
  <header class="cabecalho-pagina">
    <div class="container">
      <span class="sobretitulo">Momentos</span>
      <h1>Galeria de fotos</h1>
      <p>Um pouco do que Deus tem feito entre nós.</p>
    </div>
  </header>
  <section class="secao">
    <div class="container">
      {
        lista.length > 0 ? (
          <div class="grade">
            {lista.map(({ slug, entry }) => (
              <a class="cartao album" href={`/galeria/${slug}`}>
                <div class="album__capa">
                  <img src={versaoDaFoto(entry.fotos[0], 'p')} alt="" loading="lazy" />
                  <span class="album__total">{entry.fotos.length} {entry.fotos.length === 1 ? 'foto' : 'fotos'}</span>
                </div>
                <div class="album__corpo">
                  <h2>{entry.titulo}</h2>
                  <p>{formatarData(entry.data)}</p>
                </div>
              </a>
            ))}
          </div>
        ) : (
          <p class="vazio">Em breve, fotos dos nossos cultos e eventos.</p>
        )
      }
    </div>
  </section>
</Base>

<style>
  .album {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .album:hover h2 {
    color: var(--vermelho);
  }
  .album__capa {
    position: relative;
    aspect-ratio: 4 / 3;
    background: var(--linha);
  }
  .album__capa img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .album__total {
    position: absolute;
    right: 12px;
    bottom: 12px;
    padding: 4px 12px;
    border-radius: 999px;
    background: rgb(27 24 23 / 0.75);
    color: #fff;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .album__corpo {
    padding: 16px 20px 20px;
  }
  .album__corpo h2 {
    font-size: 1.25rem;
    margin-bottom: 4px;
    transition: color 0.15s;
  }
  .album__corpo p {
    margin: 0;
    color: var(--tinta-suave);
  }
</style>

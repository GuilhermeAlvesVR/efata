---
interface Props {
  endereco: string;
}
const { endereco } = Astro.props;
const busca = encodeURIComponent(endereco.replace(/\s+/g, ' '));
---
<div class="mapa">
  <iframe
    src={`https://www.google.com/maps?q=${busca}&output=embed`}
    title="Mapa com a localização da igreja"
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"></iframe>
</div>
<a class="botao botao--contorno" href={`https://www.google.com/maps/dir/?api=1&destination=${busca}`} target="_blank" rel="noopener">
  Traçar rota
</a>

<style>
  .mapa {
    aspect-ratio: 4 / 3;
    border-radius: var(--raio);
    overflow: hidden;
    border: 1px solid var(--linha);
    background: var(--linha);
    margin-bottom: 16px;
  }
  .mapa iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>

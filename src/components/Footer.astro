---
import Redes from './Redes.astro';
import Icone from './Icone.astro';
import { NOMES_DIAS, linkWhatsApp, type configuracoes } from '../lib/conteudo';

interface Props {
  config: Awaited<ReturnType<typeof configuracoes>>;
  horarios: { dia: string; hora: string; nome: string }[];
}
const { config, horarios } = Astro.props;
const ano = new Date().getFullYear();
---
<footer class="rodape">
  <div class="container rodape__grade">
    <div>
      <p class="rodape__nome">{config.nome}</p>
      {config.slogan && <p class="rodape__slogan">{config.slogan}</p>}
      <Redes instagram={config.instagram} youtube={config.youtube} facebook={config.facebook} />
    </div>
    {
      horarios.length > 0 && (
        <div>
          <h2 class="rodape__titulo">Cultos</h2>
          <ul class="rodape__lista">
            {horarios.map((h) => (
              <li>
                <strong>{NOMES_DIAS[h.dia]}</strong> · {h.hora}
              </li>
            ))}
          </ul>
        </div>
      )
    }
    <div>
      <h2 class="rodape__titulo">Contato</h2>
      <ul class="rodape__lista">
        {
          config.endereco && (
            <li class="com-icone">
              <Icone nome="local" tamanho={18} />
              <span>{config.endereco}</span>
            </li>
          )
        }
        {
          config.whatsapp && (
            <li class="com-icone">
              <Icone nome="whatsapp" tamanho={18} />
              <a href={linkWhatsApp(config.whatsapp)} target="_blank" rel="noopener">
                WhatsApp
              </a>
            </li>
          )
        }
        {
          config.email && (
            <li class="com-icone">
              <Icone nome="email" tamanho={18} />
              <a href={`mailto:${config.email}`}>{config.email}</a>
            </li>
          )
        }
        <li><a href="/cultos">Horários e localização</a></li>
      </ul>
    </div>
  </div>
  <div class="container rodape__base">
    <p>© {ano} {config.nome}</p>
    <p class="rodape__versiculo">“Efatá!”, que quer dizer: “Abre-te!” — Marcos 7:34</p>
  </div>
</footer>

<style>
  .rodape {
    background: var(--tinta);
    color: #e9e4e1;
    padding: 56px 0 24px;
  }
  .rodape a {
    color: #fff;
  }
  .rodape__grade {
    display: grid;
    gap: 36px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
  }
  .rodape__nome {
    font-family: var(--fonte-titulo);
    font-size: 1.5rem;
    font-weight: 600;
    color: #fff;
    margin: 0 0 4px;
  }
  .rodape__slogan {
    color: #c9c1bd;
    margin-bottom: 20px;
  }
  .rodape__titulo {
    font-family: var(--fonte-texto);
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #e5a5a7;
    margin-bottom: 14px;
  }
  .rodape__lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .com-icone {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    white-space: pre-line;
  }
  .com-icone :global(svg) {
    flex-shrink: 0;
    margin-top: 3px;
  }
  .rodape__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid rgb(255 255 255 / 0.12);
    font-size: 0.9rem;
    color: #a9a19d;
  }
  .rodape__base p {
    margin: 0;
  }
  .rodape__versiculo {
    font-style: italic;
  }
</style>

---
// O site é gerado no momento da publicação. Este script ajusta os eventos no navegador,
// sem precisar republicar: marca os de hoje com "É hoje!" e tira de "Próximos" os que já passaram.
---
<script>
  let hoje = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Sao_Paulo' }).format(new Date());
  // Para testar no computador: http://127.0.0.1:4321/eventos?data=2026-10-24
  if (import.meta.env.DEV) hoje = new URLSearchParams(location.search).get('data') ?? hoje;

  document.querySelectorAll<HTMLElement>('[data-evento-data]').forEach((el) => {
    if (el.dataset.eventoData !== hoje) return;
    el.classList.add('evento--hoje');
    el.querySelectorAll<HTMLElement>('[data-selo-hoje]').forEach((s) => (s.hidden = false));
  });
  document.querySelectorAll<HTMLElement>('[data-hoje-para]').forEach((el) => {
    el.hidden = el.dataset.hojePara !== hoje;
  });

  document.querySelectorAll<HTMLElement>('[data-lista-futuros]').forEach((lista) => {
    const passados = document.querySelector<HTMLElement>('[data-lista-passados]');
    lista.querySelectorAll<HTMLElement>('[data-evento-data]').forEach((card) => {
      if ((card.dataset.eventoData ?? '') >= hoje) return;
      if (passados) {
        passados.prepend(card);
        passados.closest<HTMLElement>('[data-secao-passados]')?.removeAttribute('hidden');
      } else {
        card.remove();
      }
    });

    const limite = Number(lista.dataset.limite || 0);
    if (limite) {
      [...lista.children].forEach((c, i) => ((c as HTMLElement).hidden = i >= limite));
    }
    const vazio = lista.parentElement?.querySelector<HTMLElement>('[data-vazio]');
    if (vazio) vazio.hidden = lista.children.length > 0;
  });
</script>
